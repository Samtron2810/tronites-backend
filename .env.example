# Copy to .env and fill in real values. Never commit .env itself.

# ── Server ───────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── Database ─────────────────────────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017/tronites

# ── Auth ─────────────────────────────────────────────────────────────────
JWT_SECRET=replace-with-a-long-random-string
# Used to hash OTP codes before storing them (see models/Otp.js) — a
# separate secret from JWT_SECRET so rotating one doesn't invalidate the
# other.
OTP_HASH_SECRET=replace-with-a-different-long-random-string
# Used to hash refresh tokens before storing them (see models/Session.js,
# utils/tokens.js) — same reasoning as OTP_HASH_SECRET, a distinct
# secret so leaking one doesn't compromise the others.
REFRESH_HASH_SECRET=replace-with-yet-another-long-random-string

# ── CORS ─────────────────────────────────────────────────────────────────
# Comma-separated list of frontend origins allowed to call this API.
# Either name works (see config/allowedOrigins.js) — set one.
FRONTEND_ORIGINS=http://localhost:5173
# CORS_ORIGINS=http://localhost:5173

# ── Redis (optional — see utils/redis.js; the app degrades gracefully
# without it: caching, rate limiting, presence, and the image-upload
# queue all fall back to in-memory/direct behavior) ────────────────────
REDIS_URL=redis://localhost:6379
REDIS_CONNECT_TIMEOUT_MS=5000

# ── Cloudinary (required for image/video uploads) ──────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Publicly reachable URL of this backend — required for video posts
# specifically (see queues/videoUploadWorker.js): Cloudinary calls this
# back at {BACKEND_PUBLIC_URL}/api/webhooks/cloudinary once async video
# processing finishes. No trailing slash. For local development this
# needs a tunnel (e.g. ngrok) since Cloudinary can't reach localhost.
BACKEND_PUBLIC_URL=https://your-backend.example.com

# ── Brevo (transactional email — OTP delivery) ──────────────────────────
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Tronites
