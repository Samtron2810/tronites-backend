# Copy to .env and fill in real values. Never commit .env itself.

# ── Server ───────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── Database ─────────────────────────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017/tronites

# ── Auth ─────────────────────────────────────────────────────────────────
JWT_SECRET=replace-with-a-long-random-string
# Used to hash OTP codes before storing them (see models/Otp.js) — a
# separate secret from JWT_SECRET so rotating one doesn't invalidate the
# other.
OTP_HASH_SECRET=replace-with-a-different-long-random-string
# Used to hash refresh tokens before storing them (see models/Session.js,
# utils/tokens.js) — same reasoning as OTP_HASH_SECRET, a distinct
# secret so leaking one doesn't compromise the others.
REFRESH_HASH_SECRET=replace-with-yet-another-long-random-string

# ── CORS ─────────────────────────────────────────────────────────────────
# Comma-separated list of frontend origins allowed to call this API.
# Either name works (see config/allowedOrigins.js) — set one.
FRONTEND_ORIGINS=http://localhost:5173
# CORS_ORIGINS=http://localhost:5173

# ── Redis (optional — see utils/redis.js; the app degrades gracefully
# without it: caching, rate limiting, presence, and the image-upload
# queue all fall back to in-memory/direct behavior) ────────────────────
REDIS_URL=redis://localhost:6379
REDIS_CONNECT_TIMEOUT_MS=5000

# ── Cloudinary (required for image/video uploads) ──────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Publicly reachable URL of this backend — required for video posts
# specifically (see queues/videoUploadWorker.js): Cloudinary calls this
# back at {BACKEND_PUBLIC_URL}/api/webhooks/cloudinary once async video
# processing finishes. No trailing slash. For local development this
# needs a tunnel (e.g. ngrok) since Cloudinary can't reach localhost.
BACKEND_PUBLIC_URL=https://your-backend.example.com

# ── Brevo (transactional email — OTP delivery) ──────────────────────────
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Tronites

# ── Fairness tuning (For You ranking — see TRONITES_RANKING_FAIRNESS.md,
# services/engagementVelocityService.js, jobs/computeForYouSignals.js) ──
# All optional. Every value below is a first-guess default, not one
# tuned against real production data (there isn't any yet) — these exist
# so tuning later is a config change, not a redeploy. Each firing is
# logged (VELOCITY_FLAG / IMPLICIT_FOLLOW_FLAG console lines) precisely
# so there's a real dataset to tune these against once there's traffic.

# Real-time velocity circuit breaker (services/engagementVelocityService.js).
# A post gets flagged if (likes + comments*2) exceeds the author's
# followerCount by this multiple within its first hour — the "bought
# engagement on a small account" pattern. Default: 15.
VELOCITY_IMPLAUSIBLE_MULTIPLE=15

# Implicit hashtag follows (jobs/computeForYouSignals.js's
# recomputeImplicitHashtagFollows) — derives interest in a hashtag from
# repeated posting/engagement instead of requiring an explicit follow,
# so For You's `interest` source has real data for active users. All
# three are counts over a rolling 30-day window.
# Posts with the same tag needed to trigger an implicit follow. Default: 3.
IMPLICIT_FOLLOW_POST_THRESHOLD=3
# Likes/comments on posts with the same tag needed to trigger an
# implicit follow. Default: 5.
IMPLICIT_FOLLOW_ENGAGEMENT_THRESHOLD=5
# Combined signal floor below which a previously-implicit follow is
# removed as stale. Default: 1.
IMPLICIT_FOLLOW_STALE_THRESHOLD=1
